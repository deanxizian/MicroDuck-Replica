(title_block (title "MicroDuck Banana - positive-side PPTC prototype") (date "2026-11-03") (rev "0.5-PPTC") (comment 1 "Based on jyg9 banana_pcb 0.2; CERN-OHL-P v2"))
(wire (pts (xy 105.41 82.55) (xy 123.19 82.55)) (stroke (width 0) (type default)) (uuid "795f70b7-e6cb-5683-8493-45df02ece048"))
(wire (pts (xy 130.81 82.55) (xy 142.24 82.55)) (stroke (width 0) (type default)) (uuid "2bebe2f8-dbea-5b24-958e-1f775a8cf3fa"))
(wire (pts (xy 142.24 82.55) (xy 142.24 88.9)) (stroke (width 0) (type default)) (uuid "378f318d-bd8b-568b-a078-e3fd22a203ac"))
(wire (pts (xy 142.24 88.9) (xy 152.4 88.9)) (stroke (width 0) (type default)) (uuid "4f67e07d-706b-5ae2-8642-70ab8d920e35"))
(wire (pts (xy 105.41 96.52) (xy 142.24 96.52)) (stroke (width 0) (type default)) (uuid "22597481-99fe-5046-9f56-1364432d47ba"))
(wire (pts (xy 142.24 96.52) (xy 142.24 91.44)) (stroke (width 0) (type default)) (uuid "b929d255-7eea-552a-9a8c-712a828200c1"))
(wire (pts (xy 142.24 91.44) (xy 152.4 91.44)) (stroke (width 0) (type default)) (uuid "7007a616-71b4-59c7-b906-6e8cf66f0b26"))
(label "BATT_POS" (at 107.95 82.55 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "28dceb06-6da9-562a-81d1-826e5b5cc755"))
(label "VOUT_FUSED" (at 132.08 82.55 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "20f85188-c97d-5b49-8278-6129064dfdac"))
(label "BATT_NEG" (at 107.95 96.52 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "2b208108-a98d-5cf3-b568-813844e185b0"))
(text "MicroDuck NP-F550 Banana PCB + PPTC" (at 90 59 0) (effects (font (size 2 2)) (justify left)) (uuid "b7762f91-c69c-5a9d-b78a-f994a0d3cbc7"))
(text "0.5-PPTC / positive-side fuse / right wire exit / prototype" (at 90 65 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "e5d5de06-3c11-5afb-ad88-acfdb7ab8917"))
(text "J1 -> F1.1/F1.2 -> J3.1 -> HUB CN1.2 (VIN+)\nJ2 -------------> J3.2 -> HUB CN1.1 (GND-)" (at 90 108 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "77e9bfd2-a787-5026-a19c-a211b6ff7a61"))
(text "F1 reference: Littelfuse 2920L700/12MR, 2920 package.\nIhold 7 A / Itrip 14 A at 20 C; Vmax 12 V. 7 A is NOT an instant cutoff.\nCheck motor startup, warm hold current and fault heating on the actual robot." (at 90 119 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "dc5aa2da-7d6a-5728-aa8a-4a40783accfd"))
(text "Board 39.19 x 6.79 x 1.6 mm; 1 oz copper each side.\nF1 on LEFT; J3 moved 8 mm RIGHT to the revised holder notch.\nJ3.1 LEFT fused positive / J3.2 RIGHT direct battery negative." (at 90 135 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "98ceb26b-f0a6-5217-8c98-2fd9dc2f82d3"))
(text "The PPTC limits current when hot; clear the fault and disconnect power to reset.\nNot a substitute for battery protection or individual servo protection.\n3D fuse is a reference maximum-envelope model; actual substitute and cable fit unverified." (at 90 151 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "0f8e3d10-4156-553e-b42b-07086c988ab0"))
(text "Original outline/contact design: jyg9/microduck-community-kit, CERN-OHL-P v2.\n2026-11-03: three direct 3 mm front tracks; no back tracks; no vias." (at 90 168 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "70ee1752-c188-5911-89f1-d964a82d47d9"))
)
